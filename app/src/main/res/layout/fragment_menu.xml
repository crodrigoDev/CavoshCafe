<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.Menu">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/sh_header_police_blue"
        android:paddingStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        >

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Menu"
            android:textColor="@color/flesh"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:translationY="-30dp"
            android:src="@drawable/ic_cafes"
            android:contentDescription="@string/logo_header_cafe"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <SearchView
        android:id="@+id/svBuscar"
        android:layout_width="380dp"
        android:layout_height="48dp"
        android:translationY="20dp"
        android:background="@drawable/sh_tv_bright_gray"
        android:iconifiedByDefault="false"
        android:searchIcon="@null"
        android:submitBackground="@drawable/sh_tv_bright_gray"
        android:queryBackground="@drawable/sh_tv_bright_gray"
        android:queryHint="Buscar"
        app:layout_constraintBottom_toBottomOf="@+id/clHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:translationY="-28dp"
        android:translationX="-16dp"
        android:src="@drawable/ic_search"
        android:contentDescription="Boton de Buscar"
        android:background="@drawable/sh_btn_carmine_pink"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/svBuscar"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingTop="42dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/svBuscar"
        >

        <TextView
            android:id="@+id/texto_categoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categorias"
            android:textColor="@color/gunmetal"
            android:textStyle="bold"
            android:textSize="18sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/texto_categoria"
            />



    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>