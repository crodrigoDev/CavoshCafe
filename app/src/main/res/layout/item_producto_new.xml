<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="250dp"
    android:layout_marginStart="20dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    app:cardCornerRadius="24dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

     <androidx.constraintlayout.widget.ConstraintLayout
         android:layout_width="match_parent"
         android:layout_height="match_parent">

         <ImageView
             android:id="@+id/imgProducto"
             android:layout_width="140dp"
             android:layout_height="140dp"
             android:src="@drawable/producto"
             android:paddingVertical="15dp"
             android:layout_marginTop="10dp"
             android:background="@drawable/sh_btn_light_silver"
             android:contentDescription="imagen producto"
             app:layout_constraintTop_toTopOf="parent"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             />

         <TextView
             android:id="@+id/titleProductoCard"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="Caramel \nMacchiato"
             android:textColor="@color/gunmetal"
             android:textSize="18sp"
             android:textStyle="bold"
             android:layout_marginVertical="10dp"
             android:layout_marginHorizontal="15dp"
             app:layout_constraintTop_toBottomOf="@id/imgProducto"
             app:layout_constraintStart_toStartOf="parent"
             />

         <TextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="$"
             android:textColor="@color/carmine_pink"
             android:textSize="18sp"
             android:textStyle="bold"
             android:layout_margin="16dp"
             app:layout_constraintTop_toBottomOf="@id/titleProductoCard"
             app:layout_constraintStart_toStartOf="parent"
             />

         <TextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="4.00"
             android:textColor="@color/gunmetal"
             android:textSize="22sp"
             android:textStyle="bold"
             android:layout_marginVertical="12dp"
             android:layout_marginHorizontal="30dp"
             app:layout_constraintTop_toBottomOf="@id/titleProductoCard"
             app:layout_constraintStart_toStartOf="parent"
             />

         <ImageView
             android:layout_width="48dp"
             android:layout_height="40dp"
             android:layout_marginTop="5dp"
             android:src="@drawable/ic_agregar"
             android:background="@drawable/sh_btn_add_cart"
             android:clickable="true"
             android:focusable="true"
             app:layout_constraintBottom_toBottomOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             />

     </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>